<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TargetFramework>net10.0</TargetFramework>

        <Authors>Almighty-Shogun</Authors>
        <PackageId>AlmightyShogun.AspNet.CredentialAuth</PackageId>
        <RootNamespace>AlmightyShogun.AspNet.CredentialAuth</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Description>A C# library that adds username or email password authentication, refresh sessions, and password reset helpers to ASP.NET Core APIs.</Description>

        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/Almighty-Shogun/nuget-packages</RepositoryUrl>
        <PackageProjectUrl>https://github.com/Almighty-Shogun/nuget-packages/tree/main/packages/AlmightyShogun.AspNet.CredentialAuth</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="icon.png" Pack="true" PackagePath=""/>
        <None Update="README.md" Pack="true" PackagePath=""/>
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Otp.NET"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AlmightyShogun.Utils\AlmightyShogun.Utils.csproj"/>
        <ProjectReference Include="..\AlmightyShogun.AspNet.Core\AlmightyShogun.AspNet.Core.csproj"/>
        <ProjectReference Include="..\AlmightyShogun.AspNet.Auth\AlmightyShogun.AspNet.Auth.csproj"/>
        <ProjectReference Include="..\AlmightyShogun.AspNet.Localization\AlmightyShogun.AspNet.Localization.csproj"/>
        <ProjectReference Include="..\AlmightyShogun.AspNet.RequestValidation\AlmightyShogun.AspNet.RequestValidation.csproj"/>
    </ItemGroup>

</Project>
